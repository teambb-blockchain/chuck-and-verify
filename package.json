{
  "name": "chuck-and-verify",
  "version": "1.0.0",
  "description": "Team project for smart contracts, tests, scripts, and docs.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "start": "node index.js",
    "seed:portal": "node scripts/seed-portal.js",
    "stamp": "node scripts/stamp-assets.js",
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy:didlab": "hardhat run scripts/deploy.js --network didlab",
    "deploy:supply-chain": "CREDENTIAL_REGISTRY_ADDRESS=${CREDENTIAL_REGISTRY_ADDRESS:-0x9ef5cb328aE86C968dDcb1Fd60887bd021D7AB2E} hardhat run scripts/deploy.js --network didlab",
    "setup:credentials": "hardhat run scripts/setupCredentials.js --network didlab",
    "register:batch": "hardhat run scripts/registerBatch.js --network didlab",
    "build" :"npm --prefix frontend/dashboard ci && npm --prefix frontend/dashboard run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teambb-blockchain/chuck-and-verify.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/teambb-blockchain/chuck-and-verify/issues"
  },
  "homepage": "https://github.com/teambb-blockchain/chuck-and-verify#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "sqlite3": "^5.1.7"
  }
}
