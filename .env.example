# Copy to `.env` for Hardhat only (gitignored). Deploy/setup scripts are plain
# Node — they do not load this file; export the same names in your shell.
#
# Never put DIDLAB_PRIVATE_KEY in any file. Export it in the shell:
#   export DIDLAB_PRIVATE_KEY='0x…'   # 64 hex chars after 0x, not an address

# Hardhat didlab network + local static server
DIDLAB_RPC_URL=https://eth.didlab.org
PORT=3000

# Deploy BeefSupplyChain / setup:registry (also export these in the shell)
CREDENTIAL_REGISTRY_ADDRESS=0x…

# Optional; setup:registry defaults each holder to the deployer
# DEMO_PROCESSOR=0x…
# DEMO_INSPECTOR=0x…
# DEMO_CUSTODIAN=0x…
# CREDENTIAL_TTL_SECONDS=31536000
