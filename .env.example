# Copy to `.env` (gitignored). Hardhat loads it via dotenv for the `didlab`
# network. Leave both values empty for local compile and test.
#
# DEPLOYER_KEY is a private key: 64 hex chars after 0x, not a wallet address
# (40 hex chars). Use a disposable DIDLab lab wallet with enough TRUST for gas.
# Never commit the real value or paste it anywhere outside `.env`.
DIDLAB_RPC=https://eth.didlab.org
DEPLOYER_KEY=

# Optional, read by scripts/setupCredentials.js only. Each holder defaults to
# the deployer; set separate wallets to show role separation on chain.
# CREDENTIAL_REGISTRY_ADDRESS=0x...
# DEMO_PROCESSOR=0x...
# DEMO_INSPECTOR=0x...
# DEMO_CUSTODIAN=0x...
# CREDENTIAL_TTL_SECONDS=2592000
